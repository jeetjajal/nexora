# ============================================================
# NEXORA FRONTEND ENVIRONMENT VARIABLES
# ============================================================

# Backend API URL (Server-Side Proxy target)
# In local dev: http://localhost:8080
# In production: https://api.yourdomain.com (or leave unset to use resilient server-side mock engine)
BACKEND_URL=http://localhost:8080

# Public Client-side API URL (optional fallback)
NEXT_PUBLIC_BACKEND_URL=

# Razorpay Test / Sandbox Key ID (safe to expose to browser)
# Replace with your test key id from Razorpay Dashboard (Settings -> API Keys)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_nexora_sandbox

# Razorpay Secret Key (SERVER-SIDE ONLY - NEVER prefix with NEXT_PUBLIC_)
RAZORPAY_KEY_SECRET=
