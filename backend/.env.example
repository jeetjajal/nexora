# ==============================================================================
# NEXORA ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env before running: docker-compose up -d
# NEVER commit the real .env file with production secrets to version control.
# ==============================================================================

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_DATABASE=nexora_db
MYSQL_USER=nexora_user
MYSQL_PASSWORD=your_secure_db_password_here

# Redis Configuration
REDIS_PORT=6379

# Kafka Broker Configuration
KAFKA_PORT=9092

# Elasticsearch Configuration
ELASTICSEARCH_PORT=9200

# Application Security
JWT_SECRET=your_base64_or_hex_encoded_256_bit_secret_key_minimum_32_bytes
JWT_EXPIRATION_MS=86400000

# Payment Gateway (Razorpay Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# AI Assistant & Recommendation (Gemini API)
GEMINI_API_KEY=your_gemini_api_key_optional
